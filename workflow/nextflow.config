///////////////////////////////////////////////////////////////////////////////
// hypoxiapipe Nextflow configuration.
//
// Profiles select where processes run and in what. The workflow DSL is
// identical across all of them - that is the point of using a workflow manager
// rather than a driver script.
///////////////////////////////////////////////////////////////////////////////

params {
    // Inputs
    cohorts     = null
    signatures  = 'smith20'
    actions     = 'cox_persd'
    estimators  = ''          // empty skips nested CV

    // Behaviour
    offline               = false
    lenient_expectations  = false
    cv_outer              = 5
    cv_inner              = 3
    seed                  = 0

    // Locations
    outdir = 'results'
    cache  = "${System.getProperty('user.home')}/.cache/hypoxiapipe"

    // Images. Pin these by digest for a real run - a moving tag makes the
    // workflow reproducible only until someone pushes.
    python_image = 'ghcr.io/JimmyCarterOsei/hypoxiapipe:dev'
    r_image      = 'ghcr.io/JimmyCarterOsei/hypoxiapipe-r:dev'

    help = false
}

// Fail fast by default. `-resume` makes retrying a long ingest cheap, so
// silently retrying a failure is worse than stopping and showing it.
process {
    errorStrategy = 'terminate'
    maxRetries    = 0

    withLabel: process_low {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 8.GB
        time   = 4.h
    }
    withLabel: process_high {
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }
}

profiles {

    // Local execution against an installed package. No containers: useful for
    // development, and the only way the test profile can run in a sandbox
    // without a Docker daemon.
    standard {
        process.executor = 'local'
        docker.enabled   = false
    }

    docker {
        process.executor = 'local'
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        // The R stage is reached from the Python image by launching the R
        // image, so the containerised process needs the host Docker socket.
        // Nextflow's own per-process containers are the alternative; this
        // keeps the survival call identical in every environment.
        env.HYPOXIAPIPE_R_COMMAND = "docker run --rm -i ${params.r_image}"
    }

    singularity {
        process.executor      = 'local'
        singularity.enabled   = true
        singularity.autoMounts = true
        env.HYPOXIAPIPE_R_COMMAND = "singularity run docker://${params.r_image}"
    }

    // Fast, offline, no containers: the CI smoke run. Fixtures are generated
    // into a temporary cache by tools/make_test_fixtures.py.
    test {
        process.executor = 'local'
        docker.enabled   = false

        params.cohorts    = "${projectDir}/../tests/fixtures/workflow/demo_cohort.yaml"
        params.signatures = 'smith20'
        params.actions    = 'cox_persd,quartile'
        params.estimators = 'coxnet'
        params.offline    = true
        params.cv_outer   = 3
        params.cv_inner   = 2
        params.outdir     = 'results-test'
        params.cache      = "${projectDir}/../tests/fixtures/workflow/cache"

        process {
            withLabel: process_low    { cpus = 1; memory = 1.GB; time = 10.m }
            withLabel: process_medium { cpus = 1; memory = 2.GB; time = 10.m }
            withLabel: process_high   { cpus = 1; memory = 2.GB; time = 10.m }
        }
    }

    // Phase 9. Kept here so the DSL is demonstrably executor-agnostic; the
    // queue and work bucket are supplied at run time.
    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = params.batch_queue ?: 'hypoxiapipe-queue'
        aws.region        = params.aws_region ?: 'eu-west-2'
        docker.enabled    = true
    }
}

// Provenance of the run itself, alongside the per-step manifests the package
// writes. Overwrite is on so `-resume` does not fail on a second attempt.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }

manifest {
    name            = 'hypoxiapipe'
    description     = 'Provenance-aware transcriptomic signature validation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}
